# ═══════════════════════════════════════════════════════════════════════════
# CED — PRODUCCIÓN (plantilla)
# Copiar valores a Railway (API + Web). NUNCA commitear secretos reales.
# Dominio canónico: https://ced-castillo.com
# ═══════════════════════════════════════════════════════════════════════════

# ─── Entorno ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ─── URLs públicas (HTTPS obligatorio) ───────────────────────────────────────
# Frontend (canónico)
WEB_PUBLIC_URL=https://ced-castillo.com
NEXT_PUBLIC_SITE_URL=https://ced-castillo.com
NEXT_PUBLIC_APP_URL=https://ced-castillo.com

# Backend Railway
API_PUBLIC_URL=https://ced-web-production.up.railway.app
NEXT_PUBLIC_API_URL=https://ced-web-production.up.railway.app
# Proxy BFF en servicio WEB (runtime — corrige 404 sin rebuild)
CED_API_URL=https://ced-web-production.up.railway.app

# CORS: dominio(s) del frontend (coma separada)
CORS_ORIGINS=https://ced-castillo.com,https://www.ced-castillo.com,https://cedweb-production.up.railway.app

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=tu-jwt-secret

# ─── Stripe LIVE ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
STRIPE_PRICE_FOUNDING=price_...
STRIPE_PRICE_RECHARGE_10=price_...
STRIPE_PRICE_RECHARGE_20=price_...
STRIPE_PRICE_RECHARGE_40=price_...
STRIPE_PRICE_RECHARGE_50=price_...
STRIPE_PRICE_RECHARGE_100=price_...
FOUNDING_SLOTS_MAX=50

# ─── Redis (Upstash recomendado en prod — panel SSE multi-instancia) ───────
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# ─── IA (SOLO backend — nunca NEXT_PUBLIC_) ─────────────────────────────────
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
IDEOGRAM_API_KEY=

# ─── Meta / Instagram OAuth ────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_LOGIN_CONFIG_ID=
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_engagement,pages_manage_posts,business_management,instagram_basic,instagram_manage_comments,instagram_content_publish
# Redirect URI en Meta Developers:
#   https://ced-web-production.up.railway.app/v1/meta/oauth/callback

# ─── Email (Resend) ────────────────────────────────────────────────────────
# OBLIGATORIO en Railway servicio CED-WEB (API): registro manual usa
# POST /v1/auth/register → Admin generateLink + Resend API (no SMTP GoTrue).
# 1) https://resend.com — verificar dominio ced-castillo.com
# 2) RESEND_API_KEY + EMAIL_FROM en Railway API
# 3) (Opcional) Supabase Auth → SMTP Resend para recovery/otros emails Auth
#      Host: smtp.resend.com · Port 465 · User resend · Pass re_...
#      Sender: CED <noreply@ced-castillo.com>
RESEND_API_KEY=re_...
EMAIL_FROM=CED <noreply@ced-castillo.com>

# ─── Admin ─────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=keini5868@gmail.com

# ─── YouTube (opcional, carrusel) ──────────────────────────────────────────
YOUTUBE_API_KEY=

# ─── Voz Retell AI ─────────────────────────────────────────────────────────
VOICE_PROVIDER=retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_ID=
# Clon Cartesia cedgggg — NUNCA poner agent_id aquí
RETELL_VOICE_ID=custom_voice_8b067b589132b1ae5a05e2e4b0
RETELL_WEBHOOK_SECRET=
RETELL_AUTO_BOOTSTRAP=false
ELEVENLABS_API_KEY=
NEXT_PUBLIC_VOICE_PROVIDER=retell

# ─── Pocket Option DEMO (solo admin) ───────────────────────────────────────
POCKET_OPTION_MODULE_ENABLED=false
POCKET_OPTION_SSID=

# ─── Checklist auth post-deploy (OBLIGATORIO) ──────────────────────────────
# [ ] Supabase → Authentication → URL Configuration
#       Site URL = https://ced-castillo.com
#       Redirect URLs (una por línea):
#         https://ced-castillo.com/**
#         https://ced-castillo.com/auth/callback
#         https://ced-castillo.com/reset-password
#         https://cedweb-production.up.railway.app/**
#       NO incluir app.castillodigital.com
# [ ] Supabase → Authentication → SMTP → Resend (arriba)
# [ ] Supabase → Authentication → Rate Limits → emails/h elevado
# [ ] Stripe webhook → https://ced-web-production.up.railway.app/v1/billing/webhook
# [ ] Meta OAuth redirect → API_PUBLIC_URL/v1/meta/oauth/callback
