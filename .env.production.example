# ═══════════════════════════════════════════════════════════════════════════
# CED — PRODUCCIÓN (plantilla)
# Copiar valores a Railway (API) y Vercel (Web). NUNCA commitear secretos reales.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Entorno ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ─── URLs públicas (HTTPS obligatorio) ───────────────────────────────────────
# Frontend Vercel
WEB_PUBLIC_URL=https://app.castillodigital.com
NEXT_PUBLIC_APP_URL=https://app.castillodigital.com

# Backend Railway
API_PUBLIC_URL=https://api.castillodigital.com
NEXT_PUBLIC_API_URL=https://api.castillodigital.com

# CORS: dominio(s) del frontend (coma separada)
CORS_ORIGINS=https://app.castillodigital.com,https://www.castillodigital.com

# ─── Supabase (mismo proyecto o uno dedicado prod) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=tu-jwt-secret

# ─── Stripe TEST MODE (migrar a live tras validar) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
STRIPE_PRICE_FOUNDING=price_...
STRIPE_PRICE_RECHARGE_10=price_...
STRIPE_PRICE_RECHARGE_20=price_...
STRIPE_PRICE_RECHARGE_40=price_...
STRIPE_PRICE_RECHARGE_50=price_...
STRIPE_PRICE_RECHARGE_100=price_...
FOUNDING_SLOTS_MAX=50

# ─── Redis (Upstash recomendado en prod — panel SSE multi-instancia) ───────
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# ─── IA (SOLO backend — nunca NEXT_PUBLIC_) ─────────────────────────────────
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ─── Meta / Instagram OAuth ────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_LOGIN_CONFIG_ID=
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_engagement,pages_manage_posts,business_management,instagram_basic,instagram_manage_comments,instagram_content_publish
# Redirect URI en Meta Developers:
#   https://api.castillodigital.com/v1/meta/oauth/callback

# ─── Email ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=CED <noreply@castillodigital.com>

# ─── Admin ─────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAILS=tu-email@castillodigital.com

# ─── YouTube (opcional, carrusel) ──────────────────────────────────────────
YOUTUBE_API_KEY=

# ─── Vercel-only (opcional) ────────────────────────────────────────────────
# SUPER_ADMIN_EMAILS=...  (también en Vercel si middleware web lo usa)

# ─── Checklist post-deploy ─────────────────────────────────────────────────
# [ ] Supabase → Authentication → URL Configuration → Site URL = WEB_PUBLIC_URL
# [ ] Supabase → Redirect URLs: WEB_PUBLIC_URL/** y /auth/callback
# [ ] Stripe webhook → https://ced-web-production.up.railway.app/v1/billing/webhook
# [ ] Meta OAuth redirect → API_PUBLIC_URL/v1/meta/oauth/callback
# [ ] Google AI Studio: restringir API key por dominio/IP si aplica
