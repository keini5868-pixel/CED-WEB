NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Servidor Next.js → FastAPI (proxy /api/ced/*)
CED_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# LIVE: pk_live_... (debe coincidir con sk_live_ en API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map ID vectorial (Cloud Console) — requerido para AdvancedMarkerElement
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=CED_NAVIGATION_MAP
NEXT_PUBLIC_VOICE_PROVIDER=retell
NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=true

# Solo servidor — email(s) con acceso /admin (coma separada)
SUPER_ADMIN_EMAILS=admin@example.com
