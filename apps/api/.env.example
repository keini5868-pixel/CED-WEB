OPENAI_API_KEY=
OPENAI_MODEL_VOICE=gpt-realtime
OPENAI_MODEL_RETELL_LLM=gpt-4.1-mini-2025-04-14
OPENAI_PROJECT_ID=
OPENAI_MODEL_IMAGE=gpt-image-1
OPENAI_DEFAULT_VOICE=cedar

# Gemini voz + Geocoding/Directions API (navegación modo mapa)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_LOGIN_CONFIG_ID=
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_engagement,pages_manage_posts,business_management,instagram_basic,instagram_manage_comments,instagram_content_publish
YOUTUBE_API_KEY=

RESEND_API_KEY=
EMAIL_FROM=ced@castillodigital.com

SUPER_ADMIN_EMAILS=keini5868@gmail.com

# Voz — Retell AI (default) u OpenAI Realtime legacy
VOICE_PROVIDER=retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_ID=
RETELL_VOICE_ID=
# Voz Jarvis Cartesia (cartesia-*) — usar RETELL_VOICE_ID ya configurado en Railway
RETELL_WEBHOOK_SECRET=
RETELL_AUTO_BOOTSTRAP=false
ELEVENLABS_API_KEY=
# Legacy ElevenLabs — solo bootstrap si RETELL_VOICE_ID vacío
ELEVENLABS_JARVIS_VOICE_ID=UKhFmKblQwXqi7vvaALt
# Solo si la voz es community/public en ElevenLabs
SUPPORT_CHAT_ENABLED=true
NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=true

# Voz Retell — opcional (custom_voice usa multilingual_v2 + speed 0.88)
# RETELL_VOICE_MODEL=eleven_multilingual_v2
# RETELL_VOICE_SPEED=0.88
# RETELL_VOICE_TEMPERATURE=0.82
GEMINI_VOICE_MODEL=gemini-2.5-pro

# Cerebro conversacional — Llama local (Ollama) reemplaza Gemini en voz y chats.
# Chat Avanzado sigue usando Claude (ANTHROPIC_API_KEY).
LLM_PROVIDER=llama
LLAMA_ENDPOINT=http://localhost:11434
LLAMA_MODEL=llama2:13b
LLAMA_VOICE_MODEL=llama3.2:3b
# En Railway — texto (13B) y voz (3B) en servicios Ollama separados:
# LLAMA_ENDPOINT=http://ced-llama.railway.internal:11434
# LLAMA_VOICE_ENDPOINT=http://ced-llama-voice.railway.internal:11434
# Si LLAMA_VOICE_ENDPOINT está vacío, voz usa LLAMA_ENDPOINT (transición).
RETELL_LLM_PROVIDER=llama
