APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe — PRODUCCIÓN (Railway API):
#   1) Stripe Dashboard → modo Live (toggle) → Developers → API keys
#   2) Copiar Secret key (sk_live_...) → STRIPE_SECRET_KEY
#   3) Webhooks Live → endpoint /v1/billing/webhook → signing secret (whsec_...) → STRIPE_WEBHOOK_SECRET
#   4) Products Live → price_... de cada plan → STRIPE_PRICE_*
#   5) Web: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY = pk_live_... (mismo modo Live)
# TEST local: sk_test_ / pk_test_ / price_test_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CIERRE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_FOUNDING=
STRIPE_PRICE_RECHARGE_10=
STRIPE_PRICE_RECHARGE_20=
STRIPE_PRICE_RECHARGE_40=
STRIPE_PRICE_RECHARGE_50=
STRIPE_PRICE_RECHARGE_100=
FOUNDING_SLOTS_MAX=50

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
# Debe ser un modelo Realtime (gpt-realtime / gpt-realtime-mini). NUNCA gpt-4.1-mini.
OPENAI_MODEL_VOICE=gpt-realtime-mini
OPENAI_MODEL_RETELL_LLM=gpt-4.1-mini-2025-04-14
OPENAI_PROJECT_ID=
OPENAI_MODEL_IMAGE=gpt-image-1.5
OPENAI_DEFAULT_VOICE=cedar

# Gemini voz + Geocoding/Directions API (navegación modo mapa)
# Misma GOOGLE_API_KEY sirve para Nano Banana (imágenes) vía Gemini API.
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Nano Banana 2 (calidad Studio). Fallback automático a gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ANTHROPIC_API_KEY=
# Ideogram 4.0 — solo creativos con texto literal en la imagen (no reemplaza Gemini)
IDEOGRAM_API_KEY=
IDEOGRAM_RENDERING_SPEED=TURBO
IDEOGRAM_RESOLUTION=2048x2048
TAVILY_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_LOGIN_CONFIG_ID=
META_OAUTH_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_engagement,pages_manage_posts,business_management,instagram_basic,instagram_manage_comments,instagram_content_publish
# WhatsApp Cloud API — el verify token se pega en Meta → WhatsApp → Configuration → Webhook
WHATSAPP_VERIFY_TOKEN=ced-whatsapp-verify
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
YOUTUBE_API_KEY=

RESEND_API_KEY=
EMAIL_FROM=CED <noreply@ced-castillo.com>

SUPER_ADMIN_EMAILS=admin@example.com

# Voz — Retell AI (default) u OpenAI Realtime legacy
VOICE_PROVIDER=retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_ID=
# Clon Cartesia cedgggg (NUNCA poner agent_id aquí — provoca voz incorrecta)
RETELL_VOICE_ID=custom_voice_8b067b589132b1ae5a05e2e4b0
# Voz Jarvis Cartesia — voice_id Retell del clon (custom_voice_* o cartesia-*)
RETELL_WEBHOOK_SECRET=
RETELL_AUTO_BOOTSTRAP=false
ELEVENLABS_API_KEY=
# Legacy ElevenLabs — solo bootstrap si RETELL_VOICE_ID vacío
ELEVENLABS_JARVIS_VOICE_ID=UKhFmKblQwXqi7vvaALt
# Solo si la voz es community/public en ElevenLabs
SUPPORT_CHAT_ENABLED=true
NEXT_PUBLIC_SUPPORT_CHAT_ENABLED=true

# Voz Retell — opcional (custom_voice usa multilingual_v2 + speed 0.88)
# RETELL_VOICE_MODEL=eleven_multilingual_v2
# RETELL_VOICE_SPEED=0.88
# RETELL_VOICE_TEMPERATURE=0.82
GEMINI_VOICE_MODEL=gemini-2.5-pro

# Cerebro conversacional — Llama local (Ollama) reemplaza Gemini en voz y chats.
# Chat Avanzado sigue usando Claude (ANTHROPIC_API_KEY).
LLM_PROVIDER=llama
LLAMA_ENDPOINT=http://localhost:11434
LLAMA_MODEL=llama3.1:8b
LLAMA_VOICE_MODEL=llama3.2:3b
# En Railway — texto (13B) y voz (3B) en servicios Ollama separados:
# LLAMA_ENDPOINT=http://ced-llama.railway.internal:11434
# LLAMA_VOICE_ENDPOINT=http://ced-llama-voice.railway.internal:11434
# Si LLAMA_VOICE_ENDPOINT está vacío, voz usa LLAMA_ENDPOINT (transición).
# Prueba aislada voz Gemini (sin orquestador/tools): VOICE_TEST_MODE=gemini_standalone
# Módulos orquestador en standalone (csv, uno a la vez en rollout): VOICE_STANDALONE_MODULES=environment
# VOICE_TEST_MODE=
# VOICE_STANDALONE_MODULES=
# Piloto Retell LLM nativo (agente staging separado — no toca RETELL_AGENT_ID prod)
# RETELL_NATIVE_STAGING_AGENT_ID=
# RETELL_NATIVE_STAGING_LLM_ID=
# RETELL_NATIVE_PILOT_MODEL=gemini-3.0-flash
# NEXT_PUBLIC_RETELL_NATIVE_PILOT=true
# Acceso web: ?voicePilot=native
RETELL_LLM_PROVIDER=llama
