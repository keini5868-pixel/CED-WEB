# ═══════════════════════════════════════════════════════════
# Castillo Digital Web — variables de entorno (raíz)
# Copia a apps/web/.env.local y apps/api/.env
# ═══════════════════════════════════════════════════════════

# --- General ---
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (https://supabase.com/dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=tu-jwt-secret

# --- Stripe Sandbox (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ELITE_FOUNDING=price_...
STRIPE_PRICE_ELITE_REGULAR=price_...

# --- Redis (Upstash o local) ---
REDIS_URL=redis://localhost:6379/0

# --- IA (SOLO backend — nunca NEXT_PUBLIC_) ---
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# --- Email Resend ---
RESEND_API_KEY=re_...
EMAIL_FROM=ced@castillodigital.com

# --- Admin ---
SUPER_ADMIN_EMAILS=tu-email@castillodigital.com

# --- API (apps/api) ---
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
